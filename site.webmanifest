{
  "name": "PlayX | Music & Festival Portal",
  "short_name": "PlayX",
  "description": "Online and offline music web portal for Bollywood Hindi, Chhath Puja, Saawan, Durga Puja, Holi, Bhojpuri, Haryanvi, and Punjabi superhits in 320 Kbps HD audio.",
  "id": "/",
  "start_url": "./home.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "theme_color": "#24080a",
  "background_color": "#24080a",
  "categories": [
    "music",
    "entertainment",
    "lifestyle"
  ],
  "icons": [
    {
      "src": "favicon.io/favicon-16x16.png",
      "sizes": "16x16",
      "type": "image/png"
    },
    {
      "src": "favicon.io/favicon-32x32.png",
      "sizes": "32x32",
      "type": "image/png"
    },
    {
      "src": "favicon.io/android-chrome-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "favicon.io/android-chrome-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "favicon.io/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "share_target": {
    "action": "./home.html",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
