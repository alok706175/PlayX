{
  "name": "PlayX | Music & Festival Portal",
  "short_name": "PlayX",
  "description": "Online and offline music web portal for Bollywood Hindi, Chhath Puja, Saawan, Durga Puja, Holi, Bhojpuri, Haryanvi, and Punjabi superhits in 320 Kbps HD audio.",
  "id": "/",
  "start_url": "./home.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "theme_color": "#24080a",
