# =================================================================
# PlayX Auto Added Songs - Environment Configuration Template
# Copy this file to .env in this folder to configure your credentials.
# NOTE: The .env file is git-ignored and will NEVER be pushed to GitHub!
# =================================================================

# Server Port (Default: 3000)
PORT=3000

# Administrator Email and Name
ADMIN_EMAIL=deepaksinghrajput8747@gmail.com
ADMIN_NAME=Deepak Singh Rajput

# Admin Password / Secret for approving song imports & admin login
# IMPORTANT: Choose a strong, secret password for production!
ADMIN_SECRET=SetYourStrongAdminPasswordHere

# Optional: YouTube Data API v3 Key
# If provided, enables rich duration, tags, and category metadata.
# If left BLANK, the system automatically uses YouTube oEmbed (ZERO-CONFIG, FREE, NO KEY NEEDED!)
YOUTUBE_API_KEY=

# Optional: GitHub Persistent Storage Integration
# If your site is deployed via GitHub Pages / Vercel / Netlify and you want
# imported songs to be automatically committed to your GitHub repository:
# 1. Create a GitHub Personal Access Token (Fine-grained with 'Contents: Read and write' on PlayX)
# 2. Fill in the values below (PLAYX_TOKEN or GITHUB_TOKEN):
PLAYX_TOKEN=
GITHUB_TOKEN=
GITHUB_REPO=alok706175/PlayX
GITHUB_BRANCH=main
