# =================================================================
# PlayX Auto Added Songs - Environment Configuration
# Copy this file to .env in this folder to configure custom settings.
# =================================================================

# Server Port (Default: 3000)
PORT=3000

# Admin Password / Token for approving song imports
# Defaults to existing PlayX admin password (Deep@k8747) if left blank
ADMIN_SECRET=Deep@k8747

# Optional: YouTube Data API v3 Key
# If provided, enables rich duration, tags, and category metadata.
# If left BLANK, the system automatically uses YouTube oEmbed (ZERO-CONFIG, FREE, NO KEY NEEDED!)
YOUTUBE_API_KEY=

# Optional: GitHub Persistent Storage Integration
# If your site is deployed via GitHub Pages / Vercel / Netlify and you want
# imported songs to be automatically committed to your GitHub repository:
# 1. Create a GitHub Personal Access Token (Fine-grained or Classic with 'repo' scope)
# 2. Fill in the values below:
GITHUB_TOKEN=
GITHUB_REPO=alok706175/PlayX
GITHUB_BRANCH=main
